{
  "name": "nobrainer-tech-flow",
  "version": "2.7.0",
  "description": "From task to done. nobrainer-tech-flow is one workflow of 18 modules for AI coding agents: it scopes the task, delegates ready work, checks the result and hands over the evidence, including what was not checked.",
  "type": "module",
  "main": ".opencode/plugins/nobrainer-tech-skills.js",
  "keywords": [
    "agent-skills",
    "agentic-workflows",
    "claude-code",
    "codex",
    "verification",
    "spec-driven-development",
    "multi-agent",
    "cursor",
    "gemini-cli",
    "opencode",
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./.pi/extensions/nobrainer-tech-skills.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "license": "MIT",
  "bin": {
    "nobrainer-tech-flow": "bin/nobrainer-tech-flow.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nobrainer-tech/nobrainer-tech-flow.git"
  },
  "homepage": "https://nobrainer.tech/flow/",
  "bugs": {
    "url": "https://github.com/nobrainer-tech/nobrainer-tech-flow/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin/",
    "skills/",
    "scripts/",
    "adapters/",
    ".opencode/",
    ".pi/",
    ".codex-plugin/",
    ".claude-plugin/",
    ".agents/plugins/",
    "plugin.json",
    "gemini-extension.json",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "AGENTS.md",
    "CLAUDE.md",
    "CONTRIBUTING.md",
    "GEMINI.md",
    "docs/*.md",
    "docs/releases/*.md",
    "hooks/",
    "assets/*.svg",
    "assets/*.png"
  ],
  "publishConfig": {
    "access": "public"
  }
}
